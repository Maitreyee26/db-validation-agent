# Source Proxy (Cosmos DB)
SOURCE_COSMOS_ENDPOINT=https://YOUR_SOURCE_ACCOUNT.documents.azure.com:443/
SOURCE_COSMOS_KEY=YOUR_SOURCE_KEY
SOURCE_COSMOS_DATABASE=YOUR_SOURCE_DATABASE
SOURCE_COSMOS_CONTAINER=YOUR_SOURCE_CONTAINER

# Target Proxy (Cosmos DB)
TARGET_COSMOS_ENDPOINT=https://YOUR_TARGET_ACCOUNT.documents.azure.com:443/
TARGET_COSMOS_KEY=YOUR_TARGET_KEY
TARGET_COSMOS_DATABASE=YOUR_TARGET_DATABASE
TARGET_COSMOS_CONTAINER=YOUR_TARGET_CONTAINER
